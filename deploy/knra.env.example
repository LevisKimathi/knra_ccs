# Install to /etc/knra/knra.env (chmod 600). Never commit the real file.
DATABASE_URL="ecto://knra_web:CHANGE_ME@localhost/knra_prod"
POOL_SIZE=10
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE="CHANGE_ME"
PHX_HOST="ccs.knra.go.ke"
# Must not clash with another app on the same server
PORT=4001
PHX_SERVER=true
UPLOADS_DIRECTORY="/srv/knra/uploads"

# Email: staff log in with emailed links; detention / device-fault alerts.
# While SMTP_HOST is unset, emails (incl. login links) go to journalctl -u knra.
#SMTP_HOST="smtp.example.com"
#SMTP_PORT=587
#SMTP_USERNAME=""
#SMTP_PASSWORD=""
MAIL_FROM="no-reply@knra.go.ke"

# KenTrade PGA Container Enquiry API (outbound)
KENTRADE_BASE_URL="https://tfptrial.kenyatradenet.go.ke"
KENTRADE_USERNAME="CHANGE_ME"
KENTRADE_PASSWORD="CHANGE_ME"
KENTRADE_AGENCY_CODE="KRPB"
KENTRADE_MOCK=false

# Container status API (KenTrade calls us)
STATUS_API_FROM="CHANGE_ME"
STATUS_API_USERNAME="CHANGE_ME"
STATUS_API_PASSWORD="CHANGE_ME"
STATUS_WINDOW_DAYS=60

SIMULATORS_ENABLED=false
