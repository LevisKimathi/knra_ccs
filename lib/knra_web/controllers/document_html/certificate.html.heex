<.sheet back={~p"/applications/#{@app.reference}"}>
  <h2 class="mt-7 mb-1.5 text-xl font-bold tracking-wide">Radiation Screening Certificate</h2>
  <div class="mb-7 font-mono text-[13px] text-muted">
    Certificate no. {@app.certificate_number}
  </div>

  <.kv rows={[
    {"Container number", container(@app.container_number)},
    {"Application", @app.reference},
    {"Importer", @app.importer_name},
    {"Goods / HS code", "#{@app.goods_description || "—"} · #{@app.hs_code || "—"}"},
    {"UCR", @app.ucr_number},
    {"Screening point", "Port of Mombasa · #{@app.lane.name}"},
    {"Screened on", Knra.Time.format(@app.scanned_at)},
    {"Result", "No radiological objection"}
  ]} />

  <div class="mt-8 rounded border border-[#cfe0d8] bg-[#f0f6f3] px-5 py-4 text-sm leading-relaxed">
    This is to certify that the container identified above was screened at a Radiation Portal Monitor at the
    Port of Mombasa and that <strong>no radiological objection</strong>
    is raised to its release. This certificate does not constitute customs clearance.
  </div>

  <div class="mt-11 grid grid-cols-2 gap-8">
    <div class="border-t border-ink pt-2">
      <div class="text-[13px] font-semibold">{@report && @report.maker.name}</div>
      <div class="text-xs text-muted">
        Checking Officer · {@report && Knra.Time.format(@report.submitted_at)}
      </div>
    </div>
    <div class="border-t border-ink pt-2">
      <div class="text-[13px] font-semibold">
        {@report && @report.checker && @report.checker.name}
      </div>
      <div class="text-xs text-muted">
        Verification Officer · {@report && Knra.Time.format(@report.decided_at)}
      </div>
    </div>
  </div>

  <div class="mt-9 text-[11px] leading-normal text-subtle">
    Verify this certificate at {url(~p"/verify")} using the certificate number above.
    Issued electronically {Knra.Time.format(@app.cleared_at)}; valid without signature.
  </div>
</.sheet>
